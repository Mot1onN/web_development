@page "/"
@using FunFinder.Web.Components.Shared

<PageTitle>FunFinder — куда пойти в Челябинске</PageTitle>

<section class="hero" aria-labelledby="home-title">
    <div class="hero-copy">
        <h1 id="home-title">Куда пойти <span>в Челябинске?</span></h1>
        <p>От завтрака в кофейне до прогулки у воды. Выберите, чем хочется заняться сегодня.</p>
        <a class="button button--primary" href="podbor">
            Начать подбор <span aria-hidden="true">→</span>
        </a>
    </div>

    <figure class="hero-image">
        <img src="@Assets["images/chelyabinsk.webp"]" width="1280" height="960"
             alt="Набережная реки Миасс и исторический центр Челябинска" fetchpriority="high" />
        <figcaption>
            <strong>Набережная Миасса</strong>
            <span><a href="https://commons.wikimedia.org/wiki/File:%D0%92%D0%B8%D0%B4_%D0%BD%D0%B0_%D0%BD%D0%B0_%D0%B8%D1%81%D1%82%D0%BE%D1%80%D0%B8%D1%87%D0%B5%D1%81%D0%BA%D0%B8%D0%B9_%D1%86%D0%B5%D0%BD%D1%82%D1%80_%D0%B3%D0%BE%D1%80%D0%BE%D0%B4%D0%B0_%D0%A7%D0%B5%D0%BB%D1%8F%D0%B1%D0%B8%D0%BD%D1%81%D0%BA.jpg">Фото IlyaZero</a> · <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></span>
        </figcaption>
    </figure>
</section>

<section id="napravleniya" class="directions" aria-labelledby="directions-title" tabindex="-1">
    <h2 id="directions-title">Чем хотите заняться?</h2>
    <DirectionCards />
</section>
